OPENAI_API_KEY=sk-your-key-here
PORT=3001
# Optional for local development; both values are required in production.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Set this to a persistent location when deploying.
DATABASE_PATH=
# Public deployments may expose history while blocking task and approval writes.
PUBLIC_READ_ONLY=false
# Set true in a public read-only production build to disable dashboard controls.
VITE_PUBLIC_READ_ONLY=false
# Vercel server-side API proxy target; leave unset for local Vite development.
OVERSEER_API_URL=
