{
  "name": "overseer",
  "version": "1.0.0",
  "description": "Human-in-the-loop AI agent control panel with observability",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "nodemon --watch src --exec ts-node src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "test": "node --experimental-strip-types --test tests/api.test.ts",
    "build": "npm run typecheck && tsc && vite build",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.47.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/uuid": "^9.0.8",
    "@vercel/node": "^21.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^7.1.0"
  }
}
